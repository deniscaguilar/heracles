{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "Heracles API",
    "version" : "v1"
  },
  "security" : [ {
    "bearerAuth" : [ ]
  } ],
  "paths" : {
    "/api/v1/admin/dead-letters/{id}/reprocess" : {
      "post" : {
        "tags" : [ "dead-letter-controller" ],
        "summary" : "Send a dead message back to the work queue (ADMIN only)",
        "operationId" : "reprocessDeadLetter",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "pattern" : "^[A-Za-z0-9_-]{1,128}$"
          }
        } ],
        "responses" : {
          "202" : {
            "description" : "Accepted",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ReprocessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tasks/{id}" : {
      "get" : {
        "tags" : [ "task-controller" ],
        "summary" : "Status of one of the caller's asynchronous tasks",
        "operationId" : "getTaskStatus",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TaskStatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me" : {
      "get" : {
        "tags" : [ "me-controller" ],
        "summary" : "Who am I: identifier and role of the caller",
        "operationId" : "getMe",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/audit-events" : {
      "get" : {
        "tags" : [ "audit-events-controller" ],
        "summary" : "Audit trail, newest first (ADMIN only)",
        "operationId" : "listAuditEvents",
        "parameters" : [ {
          "name" : "cursor",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "limit",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 50
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuditEventsResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "ReprocessResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "QUEUED" ]
          }
        },
        "required" : [ "id", "status" ]
      },
      "TaskStatusResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "PENDING", "PROCESSING", "DONE", "FAILED" ]
          },
          "resultRef" : {
            "type" : [ "string", "null" ]
          }
        },
        "required" : [ "id", "resultRef", "status" ]
      },
      "MeResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "role" : {
            "type" : "string"
          }
        },
        "required" : [ "id", "role" ]
      },
      "AuditEventResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "occurredAt" : {
            "type" : "string"
          },
          "actorUserId" : {
            "type" : [ "string", "null" ]
          },
          "actorScope" : {
            "type" : "string"
          },
          "action" : {
            "type" : "string"
          },
          "entityType" : {
            "type" : "string"
          },
          "entityId" : {
            "type" : [ "string", "null" ]
          },
          "result" : {
            "type" : "string"
          },
          "fields" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "traceId" : {
            "type" : [ "string", "null" ]
          }
        },
        "required" : [ "action", "actorScope", "actorUserId", "entityId", "entityType", "fields", "id", "occurredAt", "result", "traceId" ]
      },
      "AuditEventsResponse" : {
        "type" : "object",
        "properties" : {
          "items" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/AuditEventResponse"
            }
          },
          "nextCursor" : {
            "type" : [ "string", "null" ]
          }
        },
        "required" : [ "items", "nextCursor" ]
      }
    },
    "securitySchemes" : {
      "bearerAuth" : {
        "type" : "http",
        "scheme" : "bearer",
        "bearerFormat" : "JWT"
      }
    }
  }
}
