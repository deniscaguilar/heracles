# OpenTofu: state, planos e variáveis locais nunca vão para o repositório (público).
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
override.tf
override.tf.json
*_override.tf
*.auto.tfvars
local.tfvars
backend.local.hcl

# O .gitignore da raiz ignora *.tfvars por segurança. Estes dois só têm o nome do ambiente e tamanhos (sem segredo)
# e o pipeline precisa deles; qualquer outro *.tfvars continua ignorado.
!stack/envs/prod.tfvars
!stack/envs/smoke.tfvars
