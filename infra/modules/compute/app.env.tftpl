SPRING_PROFILES_ACTIVE=all
HERACLES_DB_URL=jdbc:postgresql://${database_address}:5432/${database_name}?sslmode=require
HERACLES_DB_ADMIN_USER=${database_admin_username}
HERACLES_OIDC_ISSUER=${oidc_issuer}
HERACLES_OIDC_JWK_SET_URI=${oidc_jwk_set_uri}
HERACLES_OIDC_AUDIENCE=${oidc_audience}
HERACLES_QUEUE_URL=${work_queue_url}
HERACLES_DLQ_URL=${dlq_url}
HERACLES_QUEUE_REGION=${aws_region}
HERACLES_STORAGE_BUCKET=${bucket_name}
HERACLES_STORAGE_REGION=${aws_region}
# Empty on purpose: the application defaults point at the local ElasticMQ and LocalStack.
HERACLES_QUEUE_ENDPOINT=
HERACLES_STORAGE_ENDPOINT=
HERACLES_FAKE_ADAPTERS=false
%{ if otlp_endpoint != "" }OTEL_EXPORTER_OTLP_ENDPOINT=${otlp_endpoint}%{ endif }
