{
  "name": "@heracles/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@heracles/api-client": "file:../packages/api-client",
    "expo": "~58.0.21",
    "expo-asset": "~58.0.19",
    "expo-auth-session": "~58.0.16",
    "expo-build-properties": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-linking": "~58.0.16",
    "expo-secure-store": "~58.0.2",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "i18next": "26.7.1",
    "react": "19.3.0",
    "react-i18next": "17.1.12",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "test-renderer": "1.3.1",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/ios/",
      "/android/"
    ],
    "moduleDirectories": [
      "node_modules",
      "<rootDir>/node_modules"
    ]
  }
}
