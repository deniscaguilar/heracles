{
  "name": "@heracles/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed client of the Heracles API, generated from backend/openapi/openapi.json",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": { "node": ">=22" },
  "scripts": {
    "generate": "openapi-typescript ../../backend/openapi/openapi.json -o src/schema.d.ts",
    "build": "tsc -p tsconfig.json",
    "test": "node --test \"dist/**/*.test.js\"",
    "check": "npm run generate && npm run build && npm test"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "openapi-typescript": "7.13.0",
    "typescript": "7.0.2"
  }
}
